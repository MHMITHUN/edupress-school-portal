# MongoDB connection string. Leave unset to run in demo mode
# (in-memory store, seeded lazily with fictional sample content,
# resets on server restart).
# Example: mongodb://localhost:27017
# MONGODB_URI=

# Database name used when MONGODB_URI is set.
MONGODB_DB_NAME=edupress_portal

# Secret used to sign CMS session cookies (HMAC-SHA256).
# REQUIRED in production. If unset, a demo fallback secret is used.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Where CMS content comes from: "mongodb" (default; works standalone,
# falls back to an in-memory demo store without MONGODB_URI) or
# "wordpress" (headless WordPress REST adapter).
CMS_MODE=mongodb

# Base URL of the WordPress site, required when CMS_MODE=wordpress.
# Example: https://wp.example.com
# WORDPRESS_BASE_URL=

# Full WordPress REST API URL. Defaults to WORDPRESS_BASE_URL + /wp-json
# when unset.
# WORDPRESS_API_URL=

# WordPress username for authenticated REST writes (application
# passwords), used when CMS_MODE=wordpress.
# WORDPRESS_USERNAME=

# WordPress application password (Profile -> Application Passwords;
# shown as "xxxx xxxx xxxx xxxx" when generated).
# WORDPRESS_APP_PASSWORD=

# Base URL of an already-running dev/prod server for the Playwright
# screenshot script (scripts/screenshots.mjs). Defaults to
# http://localhost:3002 when unset.
# Example: http://localhost:3002
# BASE_URL=
